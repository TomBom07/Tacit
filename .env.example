# Optional semantic enrichment. Tacit runs deterministically without AI.
# Responses API:
# TACIT_AI_PROVIDER=responses
# TACIT_AI_ENDPOINT=https://api.openai.com/v1/responses
# TACIT_AI_API_KEY=
# TACIT_AI_MODEL=

# Or an OpenAI-compatible Chat Completions endpoint:
# TACIT_AI_PROVIDER=chat
# TACIT_AI_ENDPOINT=https://example.com/v1/chat/completions
# TACIT_AI_API_KEY=
# TACIT_AI_MODEL=

# Override local persistent store location.
# TACIT_STORE=/absolute/path/to/store.json
