{
  "manifest_version": 3,
  "name": "Tacit",
  "version": "0.1.0",
  "description": "Teach browser workflows by demonstrating them once.",
  "permissions": ["activeTab", "tabs", "storage", "webNavigation"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1:4317/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Tacit" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
